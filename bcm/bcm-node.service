[Unit]
Description=BCM Master Node Service
After=network.target

[Service]
Type=simple
User=pi2
WorkingDirectory=/home/pi2/bcm_node
ExecStartPre=/bin/bash /home/pi2/bcm_node/can_init.sh
ExecStart=/home/pi2/bcm_node/venv/bin/python /home/pi2/bcm_node/bcm/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bcm-node

[Install]
WantedBy=multi-user.target